# Marfin AI Environment Variables
# Copy this file to .env and fill in your values

# Gemini API Key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (default: gemini-1.5-flash for free-tier)
GEMINI_MODEL=gemini-1.5-flash

# NewsAPI.org key for global financial headlines (get from https://newsapi.org)
# Leave blank to use RSS-only mode (local Indonesian sources still work)
NEWS_API_KEY=your_newsapi_key_here

# Server port (default: 3000)
PORT=3000
